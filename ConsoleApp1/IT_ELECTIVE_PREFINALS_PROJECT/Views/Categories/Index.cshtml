@model IT_ELECTIVE_PREFINALS_PROJECT.ViewModels.CategoryManagementViewModel

@{
    ViewData["Title"] = "Categories Management";
}

<div class="container mt-4">
    <h2><i class="bi bi-folder-fill"></i> Ticket Categories</h2>
    <hr />

    <div class="row">
        
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Existing Categories</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td><strong>@category.Name</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add New Category</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="NewCategory.Name" class="form-label">Category Name</label>
                            <input asp-for="NewCategory.Name" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-circle"></i> Create Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>