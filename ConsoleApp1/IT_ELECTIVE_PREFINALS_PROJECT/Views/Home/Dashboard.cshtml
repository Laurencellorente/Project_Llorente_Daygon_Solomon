@model IT_ELECTIVE_PREFINALS_PROJECT.ViewModels.DashboardMetricsViewModel

@{
    ViewData["Title"] = "Solomon Operations Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-speedometer2"></i> Solomon IT Operations Dashboard</h2>
        <span class="badge bg-primary">Live Monitoring</span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-info shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Tickets</h5>
                    <h3>@Model.TotalTickets</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Open Tickets</h5>
                    <h3>@Model.OpenTickets</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Resolved Tickets</h5>
                    <h3>@Model.ResolvedTickets</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-people"></i> Active Teams</h5>
                    <h2>@Model.TotalTeams</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-tags"></i> Ticket Categories</h5>
                    <h2>@Model.TotalCategories</h2>
                </div>
            </div>
        </div>
    </div>
</div>