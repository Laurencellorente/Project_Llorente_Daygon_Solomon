@model IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket

@{
    ViewData["Title"] = "Update Ticket Status";
}

<h2>Update Ticket Status</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Ticket ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Current Status</dt>
            <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.Status?.Name</span></dd>
        </dl>

        <form asp-action="UpdateStatus">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="StatusId" class="form-label">Select New Status</label>
                <select name="statusId" class="form-select" asp-items="ViewBag.StatusId"></select>
            </div>

            <button type="submit" class="btn btn-primary">Update Status</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>