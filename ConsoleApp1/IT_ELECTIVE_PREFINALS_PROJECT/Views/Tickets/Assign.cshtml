@model IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket

@{
    ViewData["Title"] = "Assign Ticket";
}

<h2>Assign Ticket</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Ticket ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>
        </dl>

        <form asp-action="Assign">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label">Select Employee</label>
                <select name="assignedEmployeeId" class="form-select" asp-items="ViewBag.AssignedEmployeeId">
                    <option value="">-- Select Employee --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Assign</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>